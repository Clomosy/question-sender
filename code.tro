var
  MainForm : TclForm;
  QuestionChart : TClChart;
  SimpleJSONStr, LineStr : String;
  
  LblDisplay : TclLabel;
  MQTT1 : TclMQTT;
  BtnSend : TclProButton;
  
  MemOptions,QuestionMemo,AskMemo : TclMemo;
  RdoGrp : TClRadioGroup;
  
  ArrInteger : TclArrayInteger;
  GraphicLyt : TClLayout;

  TypeCombo : TCLComboBox;
  myArrayString  : TclArrayString;
  UsersList, OutgoingUsers : TclStringList;
  QMemList, QMemoList : TclJSonQuery;
  MemberCombo : TClComboBox;
  
  void MyMQTTStatusChanged;
{
  if (Not MQTT1.Connected ) 
  {
    BtnSend.Enabled = False;
    BtnSend.Text = 'Bağlantı Bekleniyor';
    try
       MQTT1.Connect;
    except
      ShowMessage('İnternet bağlantınızı kontrol ediniz... ' + 'Exception Class: ' + LastExceptionClassName + ' Exception Message: ' + LastExceptionMessage);
    }
  }
  if (MQTT1.Connected ) 
  {
    BtnSend.Text = 'Gönder';
    BtnSend.Enabled = True;
  }
}

  void ReloadChartData;  //WINDOWS ÜZERINDE 
  Var i,y   :Integer;
    LineStr :String;
    
    {
      SimpleJSONStr='';
      myArrayString = TclArrayString.Create;
      //myArrayString('clGreen','clRed','clYellow','clBlue','clYellowGreen','clAzure','clTomato','clPurple','clPink','clGold','clPeru','clOrange');
      myArrayString.Add('clGreen');
      myArrayString.Add('clYellow');
      myArrayString.Add('clYellowGreen');
      myArrayString.Add('clBlue');
      myArrayString.Add('clAzure');
      myArrayString.Add('clTomato');
      myArrayString.Add('clPurple');
      myArrayString.Add('clPink');
      myArrayString.Add('clRed');
      myArrayString.Add('clGold');
      myArrayString.Add('clPeru');
      myArrayString.Add('clOrange');
      
      
      For (i=0 To MemOptions.Lines.Count-1) 
      { 
        myArrayString.GetItem(i);
        LineStr=Clomosy.StringListItemString(MemOptions.Lines,i);
        LineStr='{"OptionValue":"'+LineStr+'","OptionCount":"'+ IntToStr(ArrInteger.GetItem(i))+'","color":"'+myArrayString.GetItem(i)+'"}';
        If (SimpleJSONStr=='') 
        SimpleJSONStr = SimpleJSONStr + LineStr 
        Else SimpleJSONStr = SimpleJSONStr + ',' + LineStr
      }
       
      SimpleJSONStr = '['+SimpleJSONStr+']';
      QuestionChart.clLoadDataFromJSONStr(SimpleJSONStr);
    }
    
    
  void MyMQTTPublishReceived;
  var 
    myStr,userGUID,userReply:String;
    i,j: Integer;
    varCntl,receivedUser : Boolean;
    
    {
      varCntl = False;
      receivedUser = False;
      If (Not MQTT1.ReceivedAlright) Exit;
      if ((Clomosy.AppPlatform == 2) || (Clomosy.AppPlatform == 3))
      {
        for (j = 0 to UsersList.Count - 1)
        {
          if (Clomosy.StringListItemString(OutgoingUsers,j) == userGUID) 
          {
            receivedUser = True;
          }
        }
        if (receivedUser == False)
        {
          MyStr = MQTT1.ReceivedMessage;
          IF (POS(';',MyStr)==0)  Exit;
          
          If (AskMemo.Text == clGetStringTo(MyStr,';')) 
          {
          Exit;
          
          } else
          {
            RdoGrp.Enabled = True;
            RdoGrp.ItemIndex = -1;
            
            RdoGrp.Title.Text = clGetStringTo(MyStr,';');//SORU
            RdoGrp.Items.Text = clGetStringAfter(MyStr,';');//SECENEKLER
            
            AskMemo.Text = RdoGrp.Title.Text;
            RdoGrp.Title.Text = '';      
            
            BtnSend.Enabled = RdoGrp.Items.Text<>'';
            BtnSend.Text = 'Gönder';
            IF (BtnSend.Enabled) 
            LblDisplay.Text = 'Seçiminizi Yapıp Göndere Basınız';
          }
        } 
      } Else 
      { 
        MyStr = MQTT1.ReceivedMessage; 
        IF (POS(';',MyStr)>0)   Exit;//içinde ; varsa çik
        
        userGUID = clGetStringTo(MyStr,'|');
        userReply = clGetStringAfter(MyStr,'|');
        
        try
          for (i = 0 to UsersList.Count - 1) 
          {
            if (Clomosy.StringListItemString(UsersList,i) == userGUID) 
            {
              varCntl = True;
              break;
            }
          }
          if (varCntl == False) 
          {
            UsersList.Add(userGUID);
             ArrInteger.SetItem(StrToInt(userReply),ArrInteger.GetItem(StrToInt(userReply)) + 1);
            ReloadChartData;
          }
        except
          ShowMessage('Exception Class: '+LastExceptionClassName+' Exception Message: '+LastExceptionMessage);
        }
      }
    }  
   
  void BtnSendClick;
  Var
    i,j: Integer;
    mobilVarCntl : Boolean;
  {
      mobilVarCntl = False;
      if ((Clomosy.AppPlatform == 2) || (Clomosy.AppPlatform == 3))
      {
        if (Clomosy.AppUserProfile == 1)
        {
          if (MemberCombo.GetValueIndex(MemberCombo.ItemIndex) == '00') 
          {
            ShowMessage('Lütfen bir kullanıcı seçiniz.');
          } else
          {
          IF (RdoGrp.ItemIndex>-1) 
          {
            RdoGrp.Enabled = False;
            BtnSend.Enabled = False;
            MQTT1.Send(MemberCombo.GetValueIndex(MemberCombo.ItemIndex)+'|'+IntToStr(RdoGrp.ItemIndex));
            LblDisplay.Text = 'Yeni Soru Bekleniyor';
            BtnSend.Text = 'Seçiminiz Gönderildi';
          } Else ShowMessage('Lütfen Bir Seçim Yapınız!');
          }
        } else
        {
        IF (RdoGrp.ItemIndex>-1) 
          {
            RdoGrp.Enabled = False;
            BtnSend.Enabled = False;
            MQTT1.Send(Clomosy.AppUserGUID+'|'+IntToStr(RdoGrp.ItemIndex));
            LblDisplay.Text = 'Yeni Soru Bekleniyor';
            BtnSend.Text = 'Seçiminiz Gönderildi';
          } Else ShowMessage('Lütfen Bir Seçim Yapınız!');
        }
      } Else
      {
       If ((Trim(QuestionMemo.Text)<>'') && (Trim(MemOptions.Text)<>'') && (Trim(QuestionMemo.Text)<>'Sorunuzu girebilirsiniz...') && (Trim(MemOptions.Text)<>'Seçenekleri girebilirsiniz..')) 
       {
           MemOptions.Text = Trim(MemOptions.Text);
          
           If (QuestionChart.ChartItemText <> QuestionMemo.Text)
           {
             ArrInteger.RemoveAll;
             UsersList.Clear;
             QuestionChart.ChartItemText = QuestionMemo.Text;
             For (i=0 To MemOptions.Lines.Count)  ArrInteger.Add(0);
             ReloadChartData;
             MQTT1.Send(QuestionMemo.Text + ';' + MemOptions.Text);
           } else
           {
            
            with QMemList do
           {
             if (Found) 
             {
               First;
               while (not EOF) 
               {
                 for (j = 0 to OutgoingUsers.Count - 1) 
                {
                  mobilVarCntl = False;
                  if (Clomosy.StringListItemString(OutgoingUsers,j) == FieldByName('Member_GUID').AsString)
                  {
                    mobilVarCntl = True;
                    OutgoingUsers.Add(FieldByName('Member_GUID').AsString);
                    break;
                  }
                }
                 if (mobilVarCntl == false)
                 {
                  MQTT1.Send(QuestionMemo.Text + ';' + MemOptions.Text);
                  break;
                  }
                 Next;
               }
             }
           }
          }
       } Else ShowMessage('Soru ve Seçenekler olmalı!');
      }
  }
  
  
void TypeGrapic;
var 
  str : String;
  I,grapic : Integer;
{
  
    str = TypeCombo.GetValueIndex(TypeCombo.ItemIndex);
    grapic = StrToInt(str);
    myArrayString = TclArrayString.Create;
    
    myArrayString.Add('clGreen');
    myArrayString.Add('clYellow');
    myArrayString.Add('clYellowGreen');
    myArrayString.Add('clBlue');
    myArrayString.Add('clAzure');
    myArrayString.Add('clTomato');
    myArrayString.Add('clPurple');
    myArrayString.Add('clPink');
    myArrayString.Add('clRed');
    myArrayString.Add('clGold');
    myArrayString.Add('clPeru');
    myArrayString.Add('clOrange');
    
    For (i=0 To MemOptions.Lines.Count-1) 
    { 
      myArrayString.GetItem(i);
      LineStr=Clomosy.StringListItemString(MemOptions.Lines,i);
      LineStr='{"OptionValue":"'+LineStr+'","OptionCount":"'+ IntToStr(ArrInteger.GetItem(i))+'","color":"'+myArrayString.GetItem(i)+'"}';
      
      if (grapic == 1)  
      {
        QuestionChart.Charttype = clCBar;
        QuestionChart.clLoadDataFromJSONStr(SimpleJSONStr);
      }
      if (grapic == 2) 
      {
        QuestionChart.Charttype = clCLine;
        QuestionChart.clLoadDataFromJSONStr(SimpleJSONStr);
      }
      if (grapic == 3) 
      {
        QuestionChart.Charttype = clCPie;
        QuestionChart.clLoadDataFromJSONStr(SimpleJSONStr);
      }
    }
  
    
}

void ComboSelected;
var
  SelectedValue : Integer;
{
  if (MemberCombo.ItemIndex == -1)
  {
    ShowMessage('Proje listesinde üye yok!');
  }
  if ((Clomosy.AppPlatform == 2) || (Clomosy.AppPlatform == 3))
  {
    if (Clomosy.AppUserProfile == 1)
    {
      If (AskMemo.Text <> '') 
      {
        RdoGrp.Enabled = True;
        BtnSend.Enabled = RdoGrp.Items.Text<>'';
        BtnSend.Text = 'Gönder';
        IF (BtnSend.Enabled) 
        LblDisplay.Text = 'Seçiminizi Yapıp Göndere Basınız';
      }
    }
  }
}

void addComboBox;
{
  
  try
  
    QMemoList = TCLJSONQuery.Create(self);
    QMemoList = Clomosy.DBCloudQueryWith(ftMembers,'','ISNULL(PMembers.Rec_Deleted,0)=0');
    MemberCombo.AddItem('Adınızı Seçiniz..','00');
    with QMemoList do
     {
       if (Found)
       {
         First;
         while (not EOF)
         {
            MemberCombo.AddItem(FieldByName('Member_Name').AsString,FieldByName('Member_GUID').AsString);
            MainForm.AddNewEvent(MemberCombo,tbeOnChange,'ComboSelected');
            Next;
         }
       }
     }
  except
    ShowMessage('Exception Class: '+LastExceptionClassName+' Exception Message: '+LastExceptionMessage);
  }
}
    
{ 
  MainForm = TclForm.Create(Self);
  TclButton(MainForm.clFindComponent('BtnFormMenu')).Visible = False;
  UsersList = Clomosy.StringListNew;
  OutgoingUsers =  Clomosy.StringListNew;
  QMemList = Clomosy.DBCloudQueryWith(ftMembers,'','ISNULL(PMembers.Rec_Deleted,0)=0 ORDER BY NEWID()');
  LblDisplay= MainForm.AddNewLabel(MainForm,'LblDisplay','--');
  LblDisplay.Visible = False;
  
  MemberCombo = MainForm.AddNewComboBox(MainForm,'MemberCombo');
  MemberCombo.Align = alMostTop;
  MemberCombo.Margins.Top = 10;
  MemberCombo.Margins.Left = 50;
  MemberCombo.Margins.Right = 50;
  MemberCombo.Visible = False;
  
  //GONDER BUTONU IKI PLATFORMDA ÇIKIYOR
  BtnSend= MainForm.AddNewProButton(MainForm,'BtnSend','Gönder');
  MainForm.AddNewEvent(BtnSend,tbeOnClick,'BtnSendClick');
  
  AskMemo = MainForm.AddNewMemo(MainForm,'AskMemo','');
  AskMemo.TextSettings.WordWrap = True;
  AskMemo.Visible = False;
  
  RdoGrp = MainForm.AddNewRadioGroup(MainForm,'RdoGrp','?');  
  RdoGrp.Visible = False;
  RdoGrp.Align = alTop;
  
  MQTT1 = MainForm.AddNewMQTTConnection(MainForm,'MQTT1');
  MainForm.AddNewEvent(MQTT1,tbeOnMQTTStatusChanged,'MyMQTTStatusChanged');
  MainForm.AddNewEvent(MQTT1,tbeOnMQTTPublishReceived,'MyMQTTPublishReceived');
  MQTT1.Channel = 'OnlineQuiz';//project guid + channel
  MQTT1.Connect;
  
  if ((Clomosy.AppPlatform == 0) || (Clomosy.AppPlatform == 1) || (Clomosy.AppPlatform == 5)) //Windows - Linux - Mac
  {
    ArrInteger = TClArrayInteger.Create;
    
    QuestionMemo= MainForm.AddNewMemo(MainForm,'QuestionMemo','Sorunuzu girebilirsiniz...');
    QuestionMemo.Align = alTop;
    QuestionMemo.WordWrap = True;
    QuestionMemo.Height = QuestionMemo.Height;
    
    MemOptions= MainForm.AddNewMemo(MainForm,'MemOptions','Seçenekleri girebilirsiniz..');
    MemOptions.Align = alBottom;
    MemOptions.Align = alTop;
    MemOptions.Height = MemOptions.Height*4;
    BtnSend.Align = alTop;
    
    QuestionChart = MainForm.AddNewChart(MainForm,'QuestionChart','Title');
    SimpleJSONStr = '[{ "OptionValue": "Value1","OptionCount": 0,"color":"clOrange"}]';
    QuestionChart.Align = alClient;
    QuestionChart.Margins.Left = 10;
    QuestionChart.Margins.Right = 10;
    QuestionChart.Charttype = clCBar;
    QuestionChart.XAxisText ='OptionValue';
    QuestionChart.ChartItemText = 'Soru Cevap';
    QuestionChart.ChartItemsValue = 'OptionCount';
    QuestionChart.ChartTitle = 'Kim Milyoner Olmak İster Formatında Seyirci Cevapları Demo Uygulaması';
    QuestionChart.Xaxis.AutoSize =False;
    QuestionChart.Yaxis.AutoSize =False;
    QuestionChart.clLoadDataFromJSONStr(SimpleJSONStr);
    QuestionChart.SeriesMargins.Top = 20; 
    
    
    GraphicLyt = MainForm.AddNewLayout(MainForm,'GraphicLyt');
    GraphicLyt.Align=albottom;
    GraphicLyt.Height = 50;
    
    TypeCombo = MainForm.AddNewComboBox(GraphicLyt,'TypeCombo');
    TypeCombo.Align = alcenter;
    TypeCombo.Width = 300;
    TypeCombo.Margins.Bottom=6;
    TypeCombo.Margins.Left =50;
    TypeCombo.Margins.Right =10;
    
    
    TypeCombo.AddItem('Bar Grafigi','1');
    TypeCombo.AddItem('Çizgi Grafik','2');
    TypeCombo.AddItem('Pasta Grafigi','3');
    MainForm.AddNewEvent(TypeCombo,tbeOnChange,'TypeGrapic');
    
  } Else //MOBIL EKRANI
  {
    LblDisplay.Text = 'İçerik Bekleniyor...';
    LblDisplay.Align = almostTop;
    LblDisplay.Visible = True;
    LblDisplay.Height = LblDisplay.Height*4;
    
    AskMemo.Align = alTop;
    AskMemo.Text ='Soru...';
    AskMemo.Visible = True;
    AskMemo.Height = AskMemo.Height*3;
    AskMemo.ReadOnly = True;
    
    RdoGrp.Visible = True;
    RdoGrp.Align = alClient;
    
    BtnSend.Align = alTop;
    BtnSend.Align = alBottom;
    BtnSend.Height = BtnSend.Height*2;
    BtnSend.Enabled = False;
    
    if (Clomosy.AppUserProfile == 1)
    {
      MemberCombo.Visible = True;
      addComboBox;
    }
  }

  if ((Clomosy.AppPlatform == 2) || (Clomosy.AppPlatform == 3)) // mobil ise
    MainForm.Run;
  else
    MainForm.RunModal;

}
